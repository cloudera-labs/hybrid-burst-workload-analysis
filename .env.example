# Connection settings for the analysis tools.
# Copy this file to .env, then set the values for your cluster.
# The Makefile reads .env and passes the values to every command.
# Do not commit .env. Do not share a password.

# --- Cloudera Manager (needed for Impala) ---

# The base URL of the Cloudera Manager API. Add the API version at the end.
CM_BASE=https://your-cm-host:7183/api/v54

# The name of the cluster in Cloudera Manager.
CM_CLUSTER=cluster

# The user name and the password for the API. The tools use basic
# authentication and send GET requests only.
CM_USER=your-user
CM_PASSWORD=your-password

# --- Spark History Server (needed for Spark) ---

# The root URL of the Spark History Server. Use the host and the port only.
SPARK_HISTORY_URL=https://your-history-host:18489

# --- Spark model features (optional; used by `make model-features`) ---

# Four deployment constants the transport-aware model needs but the event log
# cannot hold. Leave them blank to write null in those columns. Set them to make
# the output model-ready. See docs/spark_model_features.md for how to read each.
#   sysctl net.ipv4.tcp_rmem (3rd value) or net.core.rmem_max
SPARK_WINDOW_MAX_BYTES=
#   ip link show <iface>
SPARK_MTU=
#   ping round-trip time to the cloud side, in ms
SPARK_NETWORK_LATENCY_MS=
#   network link capacity, in Gb/s
SPARK_TSG_MAX_BW_GBS=
